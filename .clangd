CompileFlags:
  CompilationDatabase: build
Diagnostics:
  Includes:
    IgnoreHeader:
      - mach/mach\.h
---
If:
  PathMatch: include/.*\.h
CompileFlags:
  Add:
    - -I../include
    - -I../vendor/uthash-2.4.0/src
---
If:
  PathMatch: examples/embed/.*\.c
CompileFlags:
  Remove: [-I*]
  Add:
    - -std=gnu23
    - -I../build/libant/include
---
If:
  PathMatch: [.*\.in, src/silver/ops/handlers\.h]
Diagnostics:
  Suppress: "*"
