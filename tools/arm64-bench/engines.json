{
  "schema": 1,
  "suite": "bench-v8",
  "protocol": 1,
  "engines": [
    {
      "id": "ant",
      "name": "Ant",
      "mode": "default-jit",
      "executable": "{engineRoot}/ant-bench-build/ant",
      "args": [],
      "versionArgs": ["--version-raw"]
    },
    {
      "id": "boa",
      "name": "Boa",
      "mode": "default",
      "executable": "{engineRoot}/engines/boa/current/boa",
      "args": [],
      "versionArgs": ["--version"]
    },
    {
      "id": "v8-jitless",
      "name": "V8 jitless",
      "mode": "jitless",
      "install": "v8",
      "executable": "{engineRoot}/engines/v8/current/d8",
      "args": ["--jitless"],
      "versionArgs": ["--version"]
    },
    {
      "id": "v8-sparkplug",
      "name": "V8 Sparkplug",
      "mode": "sparkplug",
      "install": "v8",
      "executable": "{engineRoot}/engines/v8/current/d8",
      "args": ["--no-maglev", "--no-turbofan"],
      "versionArgs": ["--version"]
    },
    {
      "id": "sm-baseline",
      "name": "SpiderMonkey baseline",
      "mode": "baseline",
      "executable": "{engineRoot}/engines/sm-baseline/current/js",
      "args": ["--no-ion"],
      "versionArgs": ["--version"]
    },
    {
      "id": "bun-jitless",
      "name": "Bun jitless",
      "mode": "jitless",
      "executable": "{engineRoot}/engines/bun-jitless/current/bun-darwin-aarch64/bun",
      "args": [],
      "env": { "BUN_JSC_useJIT": "0" },
      "versionArgs": ["--version"]
    },
    {
      "id": "kiesel",
      "name": "Kiesel",
      "mode": "default",
      "executable": "{engineRoot}/engines/kiesel/current/kiesel",
      "args": [],
      "versionArgs": ["--version"]
    },
    {
      "id": "libjs",
      "name": "LibJS",
      "mode": "default",
      "executable": "{engineRoot}/engines/libjs/current/bin/js",
      "args": ["--disable-ansi-colors", "--raw-strings"],
      "versionArgs": ["--version"]
    },
    {
      "id": "duktape",
      "name": "Duktape",
      "mode": "default",
      "executable": "{engineRoot}/engines/duktape/current/duk",
      "args": [],
      "versionArgs": []
    },
    {
      "id": "quickjs",
      "name": "QuickJS",
      "mode": "default",
      "executable": "{engineRoot}/engines/quickjs/current/qjs",
      "args": ["--script"],
      "versionArgs": []
    },
    {
      "id": "quickjs-ng",
      "name": "QuickJS-ng",
      "mode": "default",
      "executable": "{engineRoot}/engines/quickjs-ng/current/qjs",
      "args": ["--script"],
      "versionArgs": ["--version"]
    },
    {
      "id": "porffor",
      "name": "Porffor",
      "mode": "default",
      "executable": "{engineRoot}/engines/porffor/current/porf",
      "args": [],
      "versionArgs": ["--version"]
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "mode": "default",
      "executable": "{engineRoot}/engines/hermes/current/bin/hermes",
      "args": [],
      "versionArgs": []
    },
    {
      "id": "escargot",
      "name": "Escargot",
      "mode": "default",
      "executable": "{engineRoot}/engines/escargot/current/escargot",
      "args": [],
      "versionArgs": ["--version"]
    },
    {
      "id": "goja",
      "name": "goja",
      "mode": "default",
      "executable": "{engineRoot}/engines/goja/current/goja",
      "args": [],
      "versionArgs": []
    }
  ]
}
