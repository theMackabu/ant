+static int logical_const_p (uint64_t v, int short_p, int *n, int *immr, int *imms) {
+  unsigned reg_size = short_p ? 32 : 64, size = reg_size, i, cto, clo;
+  uint64_t mask, inv, nimms;
+
+  if (short_p) v &= 0xffffffff;
+  if (v == 0 || v == (~(uint64_t) 0 >> (64 - reg_size))) return FALSE;
+  do {
+    size /= 2;
+    mask = ((uint64_t) 1 << size) - 1;
+    if ((v & mask) != ((v >> size) & mask)) {
+      size *= 2;
+      break;
+    }
+  } while (size > 2);
+  mask = ~(uint64_t) 0 >> (64 - size);
+  v &= mask;
+  if (((v + (v & -v)) & v) == 0) {
+    i = __builtin_ctzll (v);
+    cto = __builtin_ctzll (~(v >> i));
+  } else {
+    v |= ~mask;
+    inv = ~v;
+    if (((inv + (inv & -inv)) & inv) != 0) return FALSE;
+    clo = __builtin_clzll (inv);
+    i = 64 - clo;
+    cto = clo + __builtin_ctzll (inv) - (64 - size);
+  }
+  *immr = (size - i) & (size - 1);
+  nimms = (~(uint64_t) (size - 1) << 1) | (cto - 1);
+  *n = ((nimms >> 6) & 1) ^ 1;
+  *imms = nimms & 0x3f;
+  return TRUE;
+}
