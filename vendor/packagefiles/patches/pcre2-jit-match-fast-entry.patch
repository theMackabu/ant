+
+#if PCRE2_CODE_UNIT_WIDTH == 8
+PCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION
+pcre2_jit_match_lean(const pcre2_code *code, PCRE2_SPTR subject, PCRE2_SIZE length,
+  PCRE2_SIZE start_offset, pcre2_match_data *match_data, pcre2_match_context *mcontext,
+  PCRE2_SIZE **ovector, uint32_t *ovcount)
+{
+#ifndef SUPPORT_JIT
+
+(void)code;
+(void)subject;
+(void)length;
+(void)start_offset;
+(void)mcontext;
+(void)ovector;
+(void)ovcount;
+return match_data->rc = PCRE2_ERROR_JIT_BADOPTION;
+
+#else
+
+pcre2_real_code *re = (pcre2_real_code *)code;
+executable_functions *functions = (executable_functions *)re->executable_jit;
+jit_function func = (jit_function)functions->executable_funcs[0];
+uint32_t oveccount = match_data->oveccount;
+jit_arguments arguments;
+int rc;
+
+if (oveccount > functions->top_bracket) oveccount = functions->top_bracket;
+arguments.str = subject + start_offset;
+arguments.begin = subject;
+arguments.end = subject + length;
+arguments.match_data = match_data;
+arguments.startchar_ptr = subject;
+arguments.mark_ptr = NULL;
+arguments.options = 0;
+arguments.callout = mcontext->callout;
+arguments.callout_data = mcontext->callout_data;
+arguments.offset_limit = PCRE2_UNSET;
+arguments.limit_match = (mcontext->match_limit < re->limit_match) ? mcontext->match_limit : re->limit_match;
+arguments.oveccount = oveccount << 1;
+if (mcontext->jit_callback_data != NULL)
+  {
+  arguments.stack = (struct sljit_stack *)(((pcre2_jit_stack *)mcontext->jit_callback_data)->stack);
+  rc = func(&arguments);
+  }
+else
+  rc = jit_machine_stack_exec(&arguments, func);
+
+if (rc > (int)oveccount) rc = 0;
+match_data->code = re;
+match_data->subject = subject;
+match_data->rc = rc;
+*ovector = match_data->ovector;
+*ovcount = match_data->oveccount;
+return rc;
+
+#endif
+}
