diff --git a/core/iwasm/common/wasm_c_api.c b/core/iwasm/common/wasm_c_api.c
index 3cd24540..f29385be 100644
--- a/core/iwasm/common/wasm_c_api.c
+++ b/core/iwasm/common/wasm_c_api.c
@@ -4843,8 +4843,21 @@ wasm_memory_grow(wasm_memory_t *memory, wasm_memory_pages_t delta)
     if (memory && memory->host_memory)
         return wasm_enlarge_memory_internal(NULL, memory->host_memory, delta);
 
-    LOG_WARNING("Calling wasm_memory_grow() by host is not supported."
-                "Only allow growing a memory via the opcode memory.grow");
+    if (!memory || !memory->inst_comm_rt)
+        return false;
+
+#if WASM_ENABLE_INTERP != 0
+    if (memory->inst_comm_rt->module_type == Wasm_Module_Bytecode)
+        return wasm_enlarge_memory_with_idx(
+            (WASMModuleInstance *)memory->inst_comm_rt, delta,
+            memory->memory_idx_rt);
+#endif
+#if WASM_ENABLE_AOT != 0
+    if (memory->inst_comm_rt->module_type == Wasm_Module_AoT)
+        return aot_enlarge_memory_with_idx(
+            (AOTModuleInstance *)memory->inst_comm_rt, delta,
+            memory->memory_idx_rt);
+#endif
     return false;
 }
 
