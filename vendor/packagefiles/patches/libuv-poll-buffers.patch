+void* uv__loop_poll_buffer(uv_loop_t* loop, size_t size, int* nested) {
+  uv__loop_internal_fields_t* lfields;
+  void* buf;
+
+  lfields = uv__get_internal_fields(loop);
+  *nested = lfields->poll_buffer_busy;
+  if (*nested) {
+    buf = uv__malloc(size);
+  } else {
+    if (lfields->poll_buffer == NULL)
+      lfields->poll_buffer = uv__malloc(size);
+    buf = lfields->poll_buffer;
+    lfields->poll_buffer_busy = 1;
+  }
+
+  if (buf == NULL)
+    abort();
+  return buf;
+}
+
+
+void uv__loop_poll_buffer_release(uv_loop_t* loop, void* buf, int nested) {
+  if (nested)
+    uv__free(buf);
+  else
+    uv__get_internal_fields(loop)->poll_buffer_busy = 0;
+}
