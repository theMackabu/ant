+int tlsuv_stream_shutdown(tlsuv_stream_t *clt) {
+    if (uv_handle_get_type((uv_handle_t*)&clt->watcher) != UV_POLL ||
+        uv_is_closing((uv_handle_t*)&clt->watcher) || clt->tls_engine == NULL) {
+        return UV_EINVAL;
+    }
+
+    if (!TAILQ_EMPTY(&clt->queue)) {
+        return UV_EBUSY;
+    }
+
+    clt->tls_engine->close(clt->tls_engine);
+#if _WIN32
+    if (shutdown(clt->sock, SD_SEND) != 0) {
+#else
+    if (shutdown(clt->sock, SHUT_WR) != 0) {
+#endif
+        return err_to_uv(get_error());
+    }
+    return 0;
+}
