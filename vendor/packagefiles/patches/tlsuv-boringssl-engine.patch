+#if !__APPLE__
+// Loaded on the first client connection that needs it and shared by every
+// context for the rest of the process.
+static X509_STORE* system_store_ = NULL;
+static uv_once_t system_store_once = UV_ONCE_INIT;
+
+#if _WIN32
+// BoringSSL has no Windows system store provider: copy the ROOT store
+static void system_store_load(void) {
+    HCERTSTORE store = CertOpenSystemStoreA(0, "ROOT");
+    if (store == NULL) {
+        UM_LOG(ERR, "failed to open system ROOT certificate store");
+        return;
+    }
+
+    X509_STORE* certs = X509_STORE_new();
+    PCCERT_CONTEXT ctx = NULL;
+    while ((ctx = CertEnumCertificatesInStore(store, ctx)) != NULL) {
+        const uint8_t* der = ctx->pbCertEncoded;
+        X509* c = d2i_X509(NULL, &der, (long)ctx->cbCertEncoded);
+        if (c != NULL) {
+            X509_STORE_add_cert(certs, c);
+            X509_free(c);
+        }
+    }
+    CertCloseStore(store, 0);
+    system_store_ = certs;
+}
+#else
+// BoringSSL only looks at SSL_CERT_FILE/SSL_CERT_DIR, /etc/ssl/cert.pem and
+// the hashed /etc/ssl/certs directory. Distributions without either (NixOS,
+// Fedora/RHEL, openSUSE) ship a bundle elsewhere.
+static const char* const ca_bundles[] = {
+    "/etc/ssl/certs/ca-certificates.crt",                // Debian, Ubuntu, Gentoo, NixOS
+    "/etc/pki/tls/certs/ca-bundle.crt",                  // Fedora, RHEL
+    "/etc/ssl/ca-bundle.pem",                            // openSUSE
+    "/etc/pki/tls/cacert.pem",                           // OpenELEC
+    "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem", // CentOS, RHEL 7
+    "/etc/ssl/certs/ca-bundle.crt",
+};
+
+static void system_store_load(void) {
+    X509_STORE* certs = X509_STORE_new();
+    X509_STORE_set_default_paths(certs);
+
+    if (getenv(X509_get_default_cert_file_env()) == NULL &&
+        access(X509_get_default_cert_file(), R_OK) != 0) {
+        for (size_t i = 0; i < sizeof(ca_bundles) / sizeof(ca_bundles[0]); i++) {
+            if (access(ca_bundles[i], R_OK) == 0 && X509_STORE_load_locations(certs, ca_bundles[i], NULL)) {
+                UM_LOG(VERB, "loaded system CA bundle[%s]", ca_bundles[i]);
+                break;
+            }
+        }
+        ERR_clear_error();
+    }
+    system_store_ = certs;
+}
+#endif
+
+static X509_STORE* system_store(void) {
+    uv_once(&system_store_once, system_store_load);
+    return system_store_;
+}
+#endif
