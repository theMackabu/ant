+static void system_store_load(void) {
+    HCERTSTORE store = CertOpenSystemStoreA(0, "ROOT");
+    if (store == NULL) {
+        UM_LOG(ERR, "failed to open system ROOT certificate store");
+        return;
+    }
+
+    X509_STORE* certs = X509_STORE_new();
+    PCCERT_CONTEXT ctx = NULL;
+    while ((ctx = CertEnumCertificatesInStore(store, ctx)) != NULL) {
+        const uint8_t* der = ctx->pbCertEncoded;
+        X509* c = d2i_X509(NULL, &der, (long)ctx->cbCertEncoded);
+        if (c != NULL) {
+            X509_STORE_add_cert(certs, c);
+            X509_free(c);
+        }
+    }
+    CertCloseStore(store, 0);
+    system_store_ = certs;
+}
