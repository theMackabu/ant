+static bool spki_blocked(X509* cert) {
+    uint8_t* der = NULL;
+    int len = i2d_X509_PUBKEY(X509_get_X509_PUBKEY(cert), &der);
+    if (len <= 0) return false;
+
+    uint8_t digest[SHA256_DIGEST_LENGTH];
+    SHA256(der, (size_t)len, digest);
+    OPENSSL_free(der);
+
+    for (size_t i = 0; i < sizeof(blocked_spkis) / sizeof(blocked_spkis[0]); i++) {
+        if (memcmp(digest, blocked_spkis[i], SHA256_DIGEST_LENGTH) == 0) return true;
+    }
+    return false;
+}
+
+static int chain_verify_cb(X509_STORE_CTX* st, void* arg) {
+    (void)arg;
+    if (X509_verify_cert(st) <= 0) return 0;
+
+    STACK_OF(X509)* chain = X509_STORE_CTX_get0_chain(st);
+    for (size_t i = 0; i < sk_X509_num(chain); i++) {
+        if (!spki_blocked(sk_X509_value(chain, i))) continue;
+        X509_STORE_CTX_set_error(st, X509_V_ERR_CERT_REVOKED);
+        return 0;
+    }
+    return 1;
+}
