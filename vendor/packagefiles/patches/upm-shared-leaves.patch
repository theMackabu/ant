+async function linked(dir: string): Promise<boolean> {
+  const file = `${dir}${SHARED_LINKS}`;
+  const text = await builtin.fsp.readFile(file, "utf8").catch(() => "");
+  const listed = text.split("\n").filter(Boolean);
+  const live: string[] = [];
+  for (const link of listed) if ((await readLink(link)) === dir) live.push(link);
+  if (live.length > 0 && live.length < listed.length) {
